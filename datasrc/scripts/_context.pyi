# Type hints for the runtime context layer in _context.py.
#
# PocketPy executes _context.py; this stub only feeds IDEs and type checkers.
# Scripts can use it for annotations:
#
#   from typing import TYPE_CHECKING
#   if TYPE_CHECKING:
#       from _context import Context

from typing import Any, Iterator, Optional, Union


Vec2Like = Union["Vec2", tuple[float, float], list[float]]
ItemLike = Union[str, "Item"]
PlayerLike = Union[int, "Player"]


class Vec2:
    x: float
    y: float

    def __init__(self, x: float = 0.0, y: float = 0.0) -> None: ...
    def __getitem__(self, index: int) -> float: ...
    def __iter__(self) -> Iterator[float]: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...
    def __add__(self, other: Vec2) -> Vec2: ...
    def __sub__(self, other: Vec2) -> Vec2: ...
    def __mul__(self, scale: float) -> Vec2: ...
    def __truediv__(self, scale: float) -> Vec2: ...
    def length(self) -> float: ...
    def normalized(self) -> Vec2: ...


class Player:
    id: int

    def __init__(self, client_id: int) -> None: ...
    @property
    def pos(self) -> Vec2: ...
    @property
    def health(self) -> int: ...
    @property
    def armor(self) -> int: ...
    @property
    def max_health(self) -> int: ...
    @property
    def alive(self) -> bool: ...
    @property
    def range_scale(self) -> float: ...
    @property
    def speed_scale(self) -> float: ...
    @property
    def team(self) -> int: ...
    @property
    def name(self) -> str: ...
    @property
    def velocity(self) -> Vec2: ...
    @property
    def grounded(self) -> bool: ...
    @property
    def aim_direction(self) -> Vec2: ...
    @property
    def weapon(self) -> str: ...
    @property
    def weapon_id(self) -> int: ...
    def teleport(self, x: float, y: float) -> bool: ...
    def set_weapon(self, slot: int) -> bool: ...
    def heal(self, amount: int) -> int: ...
    def add_armor(self, amount: int) -> int: ...
    def damage(self, amount: int, from_client: int = -1, weapon: int = -1) -> bool: ...
    def forget(self, delta: int) -> int: ...
    def chat(self, text: str, context: str = "") -> bool: ...
    def item_count(self, item_id: ItemLike) -> int: ...
    def give_item(self, item_id: ItemLike, count: int = 1) -> bool: ...
    def take_item(self, item_id: ItemLike, count: int = 1) -> bool: ...
    def add_buff(
        self,
        buff_id: str,
        duration_ticks: int = -1,
        stacks: int = 1,
        source: int = -1,
    ) -> bool: ...
    def remove_buff(self, buff_id: str) -> bool: ...
    def buff_stacks(self, buff_id: str) -> int: ...
    def __int__(self) -> int: ...
    def __repr__(self) -> str: ...


class Item:
    id: str

    def __init__(self, item_id: str) -> None: ...
    def count(self, player: PlayerLike) -> int: ...
    def give(self, player: PlayerLike, count: int = 1) -> bool: ...
    def take(self, player: PlayerLike, count: int = 1) -> bool: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...


class Entity:
    id: int

    def __init__(self, entity_id: int) -> None: ...
    @property
    def pos(self) -> Vec2: ...
    @property
    def health(self) -> int: ...
    @property
    def exists(self) -> bool: ...
    @property
    def world_id(self) -> int: ...
    def damage(self, amount: int, from_client: int = -1, weapon: int = -1) -> bool: ...
    def destroy(self) -> bool: ...
    def set_visual(self, visual: dict[str, Any]) -> bool: ...
    def update_visual(self, visual: dict[str, Any]) -> bool: ...
    def release_visual(self) -> bool: ...
    def set_health(self, health: int) -> bool: ...
    def set_persistent(self, persistent: bool) -> bool: ...
    def owner_near(self) -> int: ...
    def player_near(self, radius: float = 96.0) -> int: ...
    def __int__(self) -> int: ...
    def __repr__(self) -> str: ...


class Buff:
    id: str
    player: Optional[Player]
    state: dict[str, Any]

    def __init__(self, buff_id: str, player: Optional[Player], state: dict[str, Any]) -> None: ...
    @property
    def stacks(self) -> int: ...
    def remove(self) -> bool: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...


class Ammo:
    damage: int
    projectiles: int
    speed: float
    lifetime: float
    effect: int

    def __init__(self, data: dict[str, Any]) -> None: ...
    def __getitem__(self, key: str) -> Any: ...
    def __repr__(self) -> str: ...


class Extra:
    def __init__(self, data: dict[str, Any]) -> None: ...
    def __getattr__(self, key: str) -> Any: ...
    def __getitem__(self, key: str) -> Any: ...
    def __contains__(self, key: str) -> bool: ...


class Projectile:
    id: int

    def __init__(
        self,
        owner: Union[int, Player, None],
        pos: Vec2Like,
        direction: Vec2Like,
        span: int,
        damage: int,
        explosive: bool = False,
        sound_impact: int = -1,
        weapon: int = -1,
    ) -> None: ...
    def __repr__(self) -> str: ...


class FireParticle:
    id: int

    def __init__(
        self,
        owner: Union[int, Player, None],
        pos: Vec2Like,
        velocity: Vec2Like,
        span: int,
        damage: int,
        weapon: int = -1,
        ignore: Union[int, "Entity", None] = None,
        gravity: float = 0.0,
    ) -> None: ...
    def __repr__(self) -> str: ...


class Laser:
    id: int

    def __init__(
        self,
        owner: Union[int, Player, None],
        pos: Vec2Like,
        direction: Vec2Like,
        reach: float,
        damage: int,
    ) -> None: ...
    def __repr__(self) -> str: ...


class HealthDrop:
    id: int

    def __init__(self, pos: Vec2Like, velocity: Optional[Vec2Like] = None) -> None: ...
    @staticmethod
    def near(pos: Vec2Like, radius: float = 96.0) -> bool: ...
    def __repr__(self) -> str: ...


class DroppedPickup:
    id: int

    def __init__(
        self,
        pos: Vec2Like,
        direction: Vec2Like,
        item: str,
        count: int = 1,
    ) -> None: ...
    def __repr__(self) -> str: ...


class MeleeSwing:
    hits: int

    def __init__(
        self,
        owner: Union[int, Player, None],
        pos: Vec2Like,
        direction: Vec2Like,
        damage: int,
        range_scale: float = 1.0,
        can_harvest: bool = False,
        hit_style: int = 0,
        swing_effect: bool = True,
    ) -> None: ...
    def __repr__(self) -> str: ...


class Context:
    event: str
    player: Optional[Player]
    entity: Optional[Entity]
    item: Optional[Item]
    buff: Optional[Buff]
    weapon: Optional[str]
    kind: str
    world: int
    pos: Vec2
    dir: Vec2
    now: int
    tick_speed: int
    range_scale: float
    ammo: Ammo
    extra: Extra
    params: dict[str, Any]
    state: dict[str, Any]
    result: dict[str, Any]
    consumed: bool
    reload_ticks: int
    destroy: bool

    Vec2: type[Vec2]
    Player: type[Player]
    Entity: type[Entity]
    Item: type[Item]
    Buff: type[Buff]
    Projectile: type[Projectile]
    FireParticle: type[FireParticle]
    Laser: type[Laser]
    HealthDrop: type[HealthDrop]
    DroppedPickup: type[DroppedPickup]
    MeleeSwing: type[MeleeSwing]

    def __init__(self, raw: dict[str, Any]) -> None: ...
    @property
    def world_name(self) -> str: ...
    @property
    def floor_name(self) -> str: ...
    @property
    def world_kind(self) -> int: ...
    def snap_new_id(self) -> int: ...
    def snap_free_id(self, snap_id: int) -> bool: ...
    def heal(self, amount: int) -> int: ...
    def chat(self, text: str, context: str = "") -> bool: ...
    def __getitem__(self, key: str) -> Any: ...
    def __setitem__(self, key: str, value: Any) -> None: ...
    def __contains__(self, key: str) -> bool: ...


def make_context(raw: dict[str, Any]) -> Context: ...
